{
  "name": "tunlivo-development-tools",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "format:staged": "lint-staged",
    "dependencies": "node .github/dependencies.cjs --write && prettier --write DEPENDENCIES.md",
    "dependencies:report": "node .github/dependencies.cjs --offline --output reports/dependencies.md",
    "test:tooling": "node --test .github/*.test.cjs",
    "dockerhub:preview": "node .github/dockerhub.cjs --output reports/dockerhub-overview.md"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,yml,yaml,md,mdx,css,scss,html}": "prettier --write --ignore-unknown"
  }
}
